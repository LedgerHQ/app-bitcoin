from typing import Any, List, Optional, Tuple

Apdu = Tuple[int, int, int, int, bytes]


class DeviceError(Exception):
    """args: (ins, sw, data)"""


class Operation:
    @staticmethod
    def get_version() -> "Operation": ...
    @staticmethod
    def get_master_fingerprint() -> "Operation": ...
    @staticmethod
    def get_extended_pubkey(path: str, display: bool) -> "Operation": ...
    @staticmethod
    def register_wallet(name: str, descriptor_template: str, keys: List[str], version: int) -> "Operation": ...
    @staticmethod
    def get_wallet_address(name: str, descriptor_template: str, keys: List[str], version: int,
                           hmac: Optional[bytes], change: int, address_index: int, display: bool) -> "Operation": ...
    @staticmethod
    def sign_psbt(psbt: bytes, name: str, descriptor_template: str, keys: List[str], version: int,
                  hmac: Optional[bytes]) -> "Operation": ...
    @staticmethod
    def sign_message(message: bytes, path: str) -> "Operation": ...
    def next_apdu(self) -> Optional[Apdu]: ...
    def step(self, sw: int, data: bytes) -> Optional[Apdu]: ...
    def yielded_count(self) -> int: ...
    def output(self) -> Any: ...


def wallet_policy_serialize(name: str, descriptor_template: str, keys: List[str], version: int) -> bytes: ...
def wallet_policy_id(name: str, descriptor_template: str, keys: List[str], version: int) -> bytes: ...
