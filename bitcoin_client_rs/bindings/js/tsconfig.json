{
  "compilerOptions": {
    "target": "es2020",
    "outDir": "build/main",
    "rootDir": "ts",
    "moduleResolution": "node",
    "module": "commonjs",
    "declaration": true,
    "inlineSourceMap": true,
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "pretty": true,
    "lib": ["es2020"],
    "types": ["jest", "node"]
  },
  "include": ["ts/**/*.ts"],
  "exclude": ["node_modules", "ts/**/__tests__/**", "ts/wasm/*_bg.wasm.d.ts"],
  "compileOnSave": false
}
